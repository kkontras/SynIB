{
  "exp_name": "HatefulMemes Experiment",
  "agent": "Agent",
  "task": "classification",
  "training_params": {
    "cuda": true,
    "gpu_device": [0],
    "seed": 109,
    "batch_size": 32,
    "test_batch_size": 64,
    "data_loader_workers": 4,
    "pin_memory": false,
    "async_loading": true,
    "validation": true,
    "rec_test": true,
    "test_on_bottoms": false,
    "use_test_set": true,
    "verbose": true,
    "adversarial_training": {
      "use": false,
      "adv_epsilon": 0.01
    },
    "tdqm_disable": true,
    "wandb_disable": false,
    "res": true
  },
  "scheduler": {
    "type": "cosanneal",
    "max_lr": 0.001,
    "warm_up_steps": 100
  },
  "optimizer": {
    "type": "Adaw",
    "learning_rate": 0.0001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "beta1": 0.9,
    "beta2": 0.999
  },
  "early_stopping": {
    "max_epoch": 50,
    "end_of_epoch_check": true,
    "log_interval": 10,
    "save_every_step": 3000,
    "validate_every": 50,
    "save_every_valstep": 20,
    "validate_after": 0,
    "n_steps_stop": 20,
    "n_steps_stop_after": 0,
    "validate_with": "accuracy"
  },
  "dataset": {
    "dataloader_class": "HM_MemmapDataloader",
    "data_roots": "./data/HatefulMemes",
    "cache_root": "./data/HatefulMemes/cache_clip_b16_deberta_base",
    "image_subdir": "img",
    "valid_split": "dev_unseen",
    "test_split": "test_seen"
  },
  "model": {
    "save_base_dir": "./data/data/2025_data/synergy/HatefulMemes"
  }
}
